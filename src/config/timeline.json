  "vo": [
    { "scene": "s01", "start": 0.25, "end": 2.75, "text": "Tem promoção que chega fazendo barulho…", "tags": "[intrigued] [softly]" },
    { "scene": "s02", "start": 3.37, "end": 5.56, "text": "Mas quando você olha o preço de perto…", "tags": "[suspicious]" },
    { "scene": "s02", "start": 5.89, "end": 6.89, "text": "a história muda.", "tags": "[suspicious]" },
    { "scene": "s03", "start": 7.43, "end": 10.71, "text": "O mesmo Asad foi anunciado por cento e noventa e nove reais…", "tags": "[serious]" },
    { "scene": "s03", "start": 11.07, "end": 13.07, "text": "e por trezentos e noventa e nove.", "tags": "[surprised]" },
    { "scene": "s04", "start": 13.44, "end": 15.94, "text": "São mais de duzentos reais de diferença.", "tags": "[dramatically]" },
    { "scene": "s04", "start": 16.35, "end": 17.5, "text": "Pelo MESMO frasco.", "tags": "[dramatically]" },
    { "scene": "s05", "start": 17.97, "end": 18.5, "text": "Barato?", "tags": "[sarcastic]" },
    { "scene": "s05", "start": 18.78, "end": 19.53, "text": "Nem sempre.", "tags": "[sarcastic]" },
    { "scene": "s05", "start": 19.85, "end": 20.33, "text": "Justo?", "tags": "[confident]" },
    { "scene": "s05", "start": 20.63, "end": 21.67, "text": "É outra conversa.", "tags": "[confident]" },
    { "scene": "s06", "start": 23.03, "end": 24.64, "text": "Porque o que deve deixar rastro…", "tags": "[softly] [warmly]" },
    { "scene": "s06", "start": 24.96, "end": 25.79, "text": "é a fragrância.", "tags": "[warmly]" },
    { "scene": "s06", "start": 26.17, "end": 26.87, "text": "Não o preço.", "tags": "[warmly]" },
    { "scene": "s07", "start": 27.46, "end": 32.73, "text": "Na LR Imports, a proposta é outra: perfumes árabes selecionados e preço justo.", "tags": "[confident]" },
    { "scene": "s08", "start": 33.07, "end": 35.53, "text": "Supremacy Collector's Edition, da Afnan.", "tags": "[admiring]" },
    { "scene": "s08", "start": 35.81, "end": 38.3, "text": "Frutado, elegante e marcante.", "tags": "[warmly]" },
    { "scene": "s09", "start": 38.65, "end": 42.74, "text": "Uma fragrância feita para marcar presença. E uma escolha que faz sentido.", "tags": "[confident]" },
    { "scene": "s10", "start": 43.11, "end": 44.17, "text": "LR Imports.", "tags": "[warmly]" },
    { "scene": "s10", "start": 44.44, "end": 45.32, "text": "Deixe sua marca.", "tags": "[warmly]" },
    { "scene": "s10", "start": 45.62, "end": 46.45, "text": "Peça o seu.", "tags": "[excited]" }
  ],
